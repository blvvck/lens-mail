{
  "name": "lens-mail-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 execute lens-mail --local --file=schema.sql",
    "migrate:remote": "wrangler d1 execute lens-mail --remote --file=schema.sql",
    "migrate:incremental": "wrangler d1 migrations apply lens-mail --local",
    "migrate:incremental:remote": "wrangler d1 migrations apply lens-mail --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "postal-mime": "^2.4.1"
  }
}
